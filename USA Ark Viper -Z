class FlightDynamics:
    def __init__(self):
        self.coordinates = {"latitude": 35.3126, "longitude": -78.9642, "altitude_km": 0.0} # Geolocation Default
        self.orientation = {"pitch": 0.0, "yaw": 0.0, "roll": 0.0}

    def update_geolocation(self, lat, lon, alt):
        self.coordinates.update({"latitude": lat, "longitude": lon, "altitude_km": alt})
        return f"Position Locked: {self.coordinates}"

    def rotate(self, direction, degrees):
        """Allows navigation adjustments: up, down, left, right."""
        direction = direction.lower()
        if direction == "up":
            self.orientation["pitch"] += degrees
        elif direction == "down":
            self.orientation["pitch"] -= degrees
        elif direction == "left":
            self.orientation["yaw"] -= degrees
        elif direction == "right":
            self.orientation["yaw"] += degrees
        return f"Rotation execution success. Orientation updated: {self.orientation}"

