        }

    def mint_tokens(self, network, wallet, amount):
        if network in self.ledgers:
            self.ledgers[network][wallet] = self.ledgers[network].get(wallet, 0.0) + amount
            return f"Minted {amount} tokens on {network} network to wallet: {wallet}."
        return "Invalid DeFi network target."

    def execute_utility_tx(self, network, sender, recipient, amount):
        if network not in self.ledgers or self.ledgers[network].get(sender, 0) < amount:
            return "Transaction Denied: Insufficient Utility Tokens or invalid route."
        self.ledgers[network][sender] -= amount
        self.ledgers[network][recipient] = self.ledgers[network].get(recipient, 0) + amount
        return f"Transferred {amount} {network} tokens successfully."

