class ArkCRMDatabase:
    def __init__(self, db_name="ark_viper_crm.db"):
        self.conn = sqlite3.connect(db_name)
        self.cursor = self.conn.cursor()
        self.setup_tables()

    def setup_tables(self):
        # Operational CRM and Crew Logging
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS crew_logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                timestamp TEXT,
                department TEXT,
                log_entry TEXT,
                status TEXT
            )
        ''')
        # Inventory Tracking (Food, Materials, Tokens)
        self.cursor.execute('''
            CREATE TABLE IF NOT EXISTS inventory (
                item_name TEXT PRIMARY KEY,
                category TEXT,
                quantity REAL,
                unit TEXT
            )
        ''')
        self.conn.commit()

    def add_log(self, department, log_entry, status="NOMINAL"):
        timestamp = datetime.now().isoformat()
        self.cursor.execute(
            "INSERT INTO crew_logs (timestamp, department, log_entry, status) VALUES (?, ?, ?, ?)",
            (timestamp, department, log_entry, status)
        )
        self.conn.commit()

    def update_inventory(self, item_name, category, quantity, unit):
        self.cursor.execute('''
            INSERT INTO inventory (item_name, category, quantity, unit)
            VALUES (?, ?, ?, ?)
            ON CONFLICT(item_name) DO UPDATE SET quantity = quantity + excluded.quantity
        ''', (item_name, category, quantity, unit))
        self.conn.commit()

    def get_status_report(self):
        self.cursor.execute("SELECT * FROM crew_logs ORDER BY id DESC LIMIT 5")
        logs = self.cursor.fetchall()
        self.cursor.execute("SELECT * FROM inventory")
        inv = self.cursor.fetchall()
        return {"recent_logs": logs, "current_inventory": inv}

