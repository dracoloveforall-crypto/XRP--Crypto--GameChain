@dataclass
class SensorData:
    slab_temperature: float = 22.0  # Celsius
    ambient_temperature: float = 21.0
    water_level_pct: float = 100.0
    food_level_pct: float = 100.0
    compost_compaction_psi: float = 0.0
    compost_maturity_pct: float = 0.0
    tray_full_pct: float = 0.0

class BrawlerXHardwareController:
    """Manages the physical components of the high-durability cage."""
    def __init__(self):
        self.data = SensorData()
        self.max_safe_slab_temp = 38.0  # Max safe heating slab temp (Celsius)
        self.heating_element_on = False
        self.green_light_on = False
        self.food_led_color = "GREEN"
        self.water_led_color = "GREEN"

    def update_sensors(self):
        """Simulates real-time sensor polling."""
        # Simulate slight changes or degradation
        self.data.water_level_pct -= random.uniform(0.5, 2.0)
        self.data.food_level_pct -= random.uniform(0.2, 1.5)
        
        # Check thresholds
        self.evaluate_safety_and_indicators()

    def evaluate_safety_and_indicators(self):
        # Anti-Overheating Safeguard
        if self.data.slab_temperature > self.max_safe_slab_temp:
            logger.warning(f"CRITICAL: Overheating detected ({self.data.slab_temperature}°C)! Activating emergency cutoff.")
            self.heating_element_on = False
            self.data.slab_temperature = self.data.ambient_temperature + 2.0
        
        # Resource Indicators
        self.water_led_color = "RED" if self.data.water_level_pct <= 15.0 else "GREEN"
        self.food_led_color = "RED" if self.data.food_level_pct <= 15.0 else "GREEN"
        
        # Green Light Indicator for harvestable compost
        if self.data.compost_maturity_pct >= 100.0 and self.data.tray_full_pct >= 80.0:
            self.green_light_on = True
        else:
            self.green_light_on = False

    def engage_slab_heating(self, target_temp: float = 35.0):
        """Heats the localized bottom slab targeting waste decomposition without heating the living space."""
        if target_temp <= self.max_safe_slab_temp:
            self.heating_element_on = True
            self.data.slab_temperature = target_temp
            logger.info(f"Localized slab heating set to {target_temp}°C.")
        else:
            logger.error("Requested temperature exceeds safety threshold.")

