class MyceliumNexusEngine:
    """Controls the advanced bioreactor running BioSciFi protocols using specialized

    microbes and rapid waste-consuming mycelium strains.
    """
    def __init__(self, hardware: BrawlerXHardwareController):
        self.hardware = hardware
        self.mycelium_activity_index = 1.0
        self.moisture_optimized = True

    def process_biomass(self, waste_volume_invoiced: float):
        """Simulates accelerating breakdown when waste hits the heated tray matrix."""
        self.hardware.data.tray_full_pct += waste_volume_invoiced * 1.5
        
        # Heating accelerates the advanced mycelium metabolic rate
        if self.hardware.heating_element_on and (30.0 <= self.hardware.data.slab_temperature <= 37.0):
            acceleration = 3.5
            logger.info("Optimal localized heat detected: Mycelium digestion speed multiplied by 3.5x.")
        else:
            acceleration = 1.0

        # Digest waste into dense soil matrix
        if self.hardware.data.tray_full_pct > 10:
            conversion_rate = 5.0 * acceleration * self.mycelium_activity_index
            self.hardware.data.compost_maturity_pct += conversion_rate
            self.hardware.data.compost_compaction_psi += conversion_rate * 0.4
            
            # Cap at maximum metrics
            if self.hardware.data.compost_maturity_pct > 100.0:
                self.hardware.data.compost_maturity_pct = 100.0
            if self.hardware.data.compost_compaction_psi > 100.0:
                self.hardware.data.compost_compaction_psi = 100.0
                
        self.hardware.evaluate_safety_and_indicators()

    def harvest_soil(self) -> bool:
        """Empties the tray if the green light status allows."""
        if self.hardware.green_light_on:
            logger.info("Harvesting pure, pathogen-free composted soil. Resetting tray matrix.")
            self.hardware.data.tray_full_pct = 0.0
            self.hardware.data.compost_maturity_pct = 0.0
            self.hardware.data.compost_compaction_psi = 0.0
            self.hardware.green_light_on = False
            return True
        else:
            logger.warning("Soil is not fully processed or compacted yet. Green light is OFF.")
            return False

