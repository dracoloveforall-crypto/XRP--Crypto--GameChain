class MiniCleaningBot:
    """Controls the un-biteable, heavy-duty scraping micro-bots stationed inside the cage tracking rails."""
    def __init__(self):
        self.status = "DOCKED"  # DOCKED, CLEANING, SELF_CLEANING, CHARGING
        self.battery_pct = 100.0
        self.scraper_blade_deployed = False

    def deploy_cleaning_cycle(self) -> float:
        """Executes sweeping code, clearing floor grates, pushing waste into the sub-slab tray."""
        if self.battery_pct < 20.0:
            logger.warning("Bot battery too low for safe deployment.")
            return 0.0
        
        logger.info("Deploying un-biteable mini-bot. Lowering mechanical push-blade...")
        self.status = "CLEANING"
        self.scraper_blade_deployed = True
        self.battery_pct -= 15.0
        
        # Simulate collected waste mass transferred downwards
        swept_waste_volume = random.uniform(10.0, 25.0)
        
        # Return to docking bay automatically
        self._return_to_dock()
        return swept_waste_volume

    def _return_to_dock(self):
        logger.info("Cleaning cycle finished. Bot returning to enclosed docking slide.")
        self.scraper_blade_deployed = False
        self.status = "SELF_CLEANING"
        logger.info("Internal dock sanitation active: Spraying antiseptic and auto-charging bot.")
        self.battery_pct = 100.0
        self.status = "DOCKED"
        logger.info("Mini-bot fully docked, clean, and charged for next execution cycle.")

