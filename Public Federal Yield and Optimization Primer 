import numpy as np
import pandas as pd


class USFiscalOptimizer:
    """Simulates federal yield optimization and expenditure efficiency

    using public financial indicators.
    """

    def __init__(
        self, budget_allocations: dict, treasury_yield_curve: dict
    ):
        self.allocations = pd.Series(budget_allocations)
        self.yields = pd.Series(treasury_yield_curve)

    def optimize_idle_treasury_yield(self, idle_capital_billions: float):
        """Calculates optimal short-term interest capture on unallocated federal reserves."""
        # Weighted average yield strategy (e.g., 4-week, 8-week, 13-week T-Bills)
        weights = np.array([0.5, 0.3, 0.2])
        rates = self.yields.values[:3]

        annual_yield_rate = np.dot(weights, rates)
        annual_return = idle_capital_billions * annual_yield_rate

        return {
            "strategy": "Automated Short-Term Treasury Placement",
            "weighted_rate": f"{annual_yield_rate * 100:.2f}%",
            "projected_annual_revenue_billions": round(annual_return, 3),
        }

    def detect_budget_inefficiencies(self, variance_threshold: float = 0.15):
        """Identifies sector allocations exceeding target variance threshold."""
        avg_allocation = self.allocations.mean()
        high_variance = self.allocations[
            self.allocations > avg_allocation * (1 + variance_threshold)
        ]

        savings_potential = (
            high_variance - (avg_allocation * (1 + variance_threshold))
        ).sum()

        return {
            "flagged_sectors": high_variance.to_dict(),
            "potential_reallocation_billions": round(savings_potential, 2),
        }


if __name__ == "__main__":
    # Example simulation parameters (in Billions USD)
    budget_data = {
        "Infrastructure": 250,
        "Defense": 840,
        "Education": 120,
        "Healthcare": 950,
        "Energy": 90,
    }

    t_bill_rates = {
        "4_week": 0.052,
        "8_week": 0.053,
        "13_week": 0.054,
    }

    optimizer = USFiscalOptimizer(budget_data, t_bill_rates)

    # 1. Idle Reserve Yield Capture ($50B unallocated pool)
    yield_results = optimizer.optimize_idle_treasury_yield(
        idle_capital_billions=50.0
    )
    print("--- Treasury Yield Optimization ---")
    for key, val in yield_results.items():
        print(f"{key}: {val}")

    # 2. Budget Efficiency Check
    efficiency_results = optimizer.detect_budget_inefficiencies()
    print("\n--- Expenditure Audit Simulation ---")
    for key, val in efficiency_results.items():
        print(f"{key}: {val}")
